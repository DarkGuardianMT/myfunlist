# Productie/staging: APP_ENV=production, HTTPS en een private, blijvende sessiemap buiten de webroot.
APP_ENV=development
# Absoluut pad naar een door PHP schrijfbare map; verplicht voor de geplande productie-inrichting.
SESSION_SAVE_PATH=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=myfunlist
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Optioneel voor server-side Library-resolutie; de browsersleutel staat apart in de frontend .env.
GOOGLE_BOOKS_API_KEY=
TMDB_API_TOKEN=
RAWG_API_KEY=

# Alleen server-side; de pilot blijft uit totdat beleid en gedeelde hostopslag zijn gecontroleerd.
OPEN_LIBRARY_PILOT_ENABLED=false
OPEN_LIBRARY_SHARED_BUDGET_CONFIRMED=false
# Maximaal 20 exacte account-ID's, gescheiden door komma's zonder spaties; leeg weigert iedereen.
# Alleen backendconfiguratie: nooit wachtwoorden, e-mailadressen of VITE_-variabelen gebruiken.
OPEN_LIBRARY_TESTER_USER_IDS=
# Gedeelde MySQL-opslag via migratie 005; OPEN_LIBRARY_STATE_FILE wordt niet meer gebruikt.
# Applicatienaam en echt beheerd contactadres tussen haakjes; nooit in VITE_-variabelen zetten.
OPEN_LIBRARY_USER_AGENT=

# Verplicht buiten tests en voor de pilot: houd deze waarde (minstens 32 tekens) gelijk voor alle workers.
RATE_LIMIT_SECRET=
