{
  "name": "myfunlist/backend",
  "description": "MyFunList JSON API",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "MyFunList\\": "src/"
    }
  },
  "scripts": {
    "test": [
      "@php tests/foundation.php",
      "@php tests/schema.php",
      "@php tests/auth_http.php",
      "@php tests/library_http.php",
      "@php tests/import_http.php",
      "@php tests/lists_http.php"
    ],
    "migrate": "@php bin/migrate.php migrate",
    "migrate:status": "@php bin/migrate.php status"
  },
  "config": {
    "sort-packages": true
  }
}
