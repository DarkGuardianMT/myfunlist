# Optioneel: Google Books werkt lokaal ook zonder sleutel. VITE_ waarden zijn zichtbaar in de browserbundel.
# Beperk een publieke sleutel tot de productiesite en alleen de Books API.
VITE_GOOGLE_BOOKS_API_KEY=

# Alleen na bevestigde hosting-/beleidscontroles en expliciete activering inschakelen.
# Dit is een publieke bouwschakelaar, geen serverautorisatie of geheim.
VITE_OPEN_LIBRARY_DISCOVER_ENABLED=false
