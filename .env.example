# Alleen voor lokale ontwikkeling: alle VITE_ waarden zijn zichtbaar in de browserbundel.
# Optioneel: Google Books werkt lokaal ook zonder sleutel. Beperk een publieke sleutel tot de site en Books API.
VITE_GOOGLE_BOOKS_API_KEY=

# Alleen lokaal: gebruik deze TMDB-token niet in een publieke productie-build.
VITE_TMDB_API_TOKEN=

# Alleen lokaal: gebruik deze RAWG-sleutel niet in een publieke productie-build.
VITE_RAWG_API_KEY=
